---
import '../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import ScrollProgress from '../components/ScrollProgress.tsx';
import BackToTop from '../components/BackToTop.tsx';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = '/images/og-image.jpg',
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {Astro.url.pathname === '/' && (
      <link rel="preload" as="video" href="/images/hero-video.mp4" type="video/mp4" />
    )}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteOrigin)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteOrigin)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700&family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    <script is:inline>
      // Dark is the default regardless of OS/browser preference. Only apply
      // an override if the visitor explicitly picked light via the toggle.
      (function () {
        try {
          if (localStorage.getItem('theme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      // Astro's view-transition router doesn't reliably auto-scroll to a
      // URL hash when the target sits far down the page (e.g. navigating
      // from /aviation to /#contact). Handle it ourselves on every
      // navigation, including the very first page load.
      function scrollToHashTarget() {
        if (!location.hash) return;
        var el = document.querySelector(location.hash);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      document.addEventListener('astro:page-load', scrollToHashTarget);
    </script>
  </head>
  <body>
    <ScrollProgress client:load />
    <slot />
    <BackToTop client:load />
  </body>
</html>
